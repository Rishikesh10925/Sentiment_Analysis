# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection (local docker compose uses port 5434)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=social_sentiment
DB_USER=postgres
DB_PASSWORD=postgres

# Managed Postgres (Render/Neon) overrides the DB_* values above when set.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Required X-API-Key for POST /api/upload. Empty = open (local/demo only).
# API_KEY=

MAX_UPLOAD_MB=50
CACHE_TTL_SECONDS=120
RESEARCH_CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=120
ENABLE_DOCS=true

# Analytics
NEGATIVE_SENTIMENT_ALERT_THRESHOLD=40

# Destructive loader tests only (never point this at the demo database)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/social_sentiment_test
